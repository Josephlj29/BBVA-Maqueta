meta {
  name: DTL-15 · Detalle de movimiento de una cuenta con identificador de transacción m
  type: http
  seq: 15
}

get {
  url: {{baseUrl}}/pe/business-reconciliation/v1/accounts/001101300210515493/transactions/PE0011020130021051549300000065
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
  Digest: {{Digest}}
  Signature: {{Signature}}
  Date: {{Date}}
  Host: {{Host}}
}

assert {
  res.status: eq 400
  res.body.messages[0].message: eq The transaction number must be 31 characters.
}

docs {
  Detalle de movimiento de una cuenta con identificador de transacción menor a 31 caracteres

