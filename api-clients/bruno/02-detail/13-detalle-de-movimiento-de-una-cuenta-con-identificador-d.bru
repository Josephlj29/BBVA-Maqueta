meta {
  name: DTL-13 · Detalle de movimiento de una cuenta con identificador de transacción i
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/pe/business-reconciliation/v1/accounts/001101300105109854/transactions/PE00110201300105109854000001091
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
  Digest: {{Digest}}
  Signature: {{Signature}}
  Date: {{Date}}
  Host: {{Host}}
}

assert {
  res.status: eq 400
  res.body.messages[0].message: eq The transaction number does not exist.
}

docs {
