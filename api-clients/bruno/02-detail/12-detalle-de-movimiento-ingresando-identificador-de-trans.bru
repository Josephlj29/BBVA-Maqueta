meta {
  name: DTL-12 · Detalle de movimiento ingresando identificador de transacción con cara
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/pe/business-reconciliation/v1/accounts/001101300210515493/transactions/PE0;110201300210515*930000=0065
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
  Digest: {{Digest}}
  Signature: {{Signature}}
  Date: {{Date}}
  Host: {{Host}}
}

assert {
  res.status: eq 400
  res.body.messages[0].message: eq The transaction number only accepts letters and numbers.
}

docs {
  Detalle de movimiento ingresando identificador de transacción con caracteres no alfanuméricos

  Caso DTL-12 del plan de pruebas oficial. Esperado: HTTP 400.
}
