meta {
  name: DTL-14 · Detalle de movimiento de una cuenta con identificador de transacción m
  type: http
  seq: 14
}

get {
  url: {{baseUrl}}/pe/business-reconciliation/v1/accounts/001101300210515493/transactions/PE001102013002105154930000000066
  body: none
  auth: none
}

headers {
