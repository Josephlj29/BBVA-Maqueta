meta {
  name: Get access token
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/oauth/v2/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: client_credentials
  client_id: {{process.env.BBVA_CLIENT_ID}}
  client_secret: {{process.env.BBVA_CLIENT_SECRET}}
}

script:post-response {
  bru.setEnvVar('access_token', res.getBody().access_token);
}

assert {
  res.status: eq 200
}

docs {
  Run this first. Every other request needs `access_token`.

  This request is deliberately excluded from message signing: it authenticates with the
  client secret, and signing it would fail.

  Credentials come from your shell, never from this file:
    export BBVA_CLIENT_ID=...
    export BBVA_CLIENT_SECRET=...
    export BBVA_PRIVATE_KEY_BASE64=$(base64 -w0 clave_privada.pem)
}
