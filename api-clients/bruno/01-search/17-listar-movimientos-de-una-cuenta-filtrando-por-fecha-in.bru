meta {
  name: SRCH-17 · Listar movimientos de una cuenta filtrando por fecha inicial con forma
  type: http
  seq: 17
}

post {
  url: {{baseUrl}}/pe/business-reconciliation/v1/transactions/search
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
  Digest: {{Digest}}
  Signature: {{Signature}}
  Date: {{Date}}
  Host: {{Host}}
  Content-Type: application/json
}

body:json {
  {"contracts":["001101300105089306"],"operationDate":{"fromDate":"2024-10/01T00:00:00.000Z","toDate":"2024-11-21T00:00:00.000Z"}}
}

assert {
  res.status: eq 400
  res.body.messages[0].message: eq Invalid format for parameter operationDate.fromDate. Correct format: yyyy-MM-ddTHH:mm:ss.SSSZ
}

docs {
  Listar movimientos de una cuenta filtrando por fecha inicial con formato inválido

  Caso SRCH-17 del plan de pruebas oficial. Esperado: HTTP 400.
}
