meta {
  name: SRCH-15 · Listar movimientos con número de cuenta con caracteres alfanuméricos
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/pe/business-reconciliation/v1/transactions/search
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
  Digest: {{Digest}}
  Signature: {{Signature}}
  Date: {{Date}}
  Host: {{Host}}
  Content-Type: application/json
}

body:json {
  {"contracts":["001101300F0.1*9854"]}
}

assert {
  res.status: eq 400
  res.body.messages[0].message: eq The account number accepts only numbers.
}

docs {
  Listar movimientos con número de cuenta con caracteres alfanuméricos

  Caso SRCH-15 del plan de pruebas oficial. Esperado: HTTP 400.
}
