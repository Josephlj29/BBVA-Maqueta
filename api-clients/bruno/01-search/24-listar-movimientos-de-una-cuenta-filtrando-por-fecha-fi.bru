meta {
  name: SRCH-24 · Listar movimientos de una cuenta filtrando por fecha final mayor a la 
  type: http
  seq: 24
}

post {
  url: {{baseUrl}}/pe/business-reconciliation/v1/transactions/search
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
  Digest: {{Digest}}
  Signature: {{Signature}}
  Date: {{Date}}
  Host: {{Host}}
  Content-Type: application/json
}

body:json {
  {"contracts":["001101300210484377"],"operationDate":{"fromDate":"2024-04-20T00:00:00.000Z","toDate":"2030-12-26T00:00:00.000Z"}}
}

assert {
  res.status: eq 400
  res.body.messages[0].message: eq The parameter operationDate.toDate must be before than or equal to the current date.
}

docs {
  Listar movimientos de una cuenta filtrando por fecha final mayor a la fecha actual

  Caso SRCH-24 del plan de pruebas oficial. Esperado: HTTP 400.
