# Copy to `.env` (next to bruno.json) and fill in. `.env` is gitignored.
#
# Bruno signs natively with Node's crypto, so it needs the private key itself.
# The Postman collection does NOT — it delegates signing to the local backend.

BBVA_CLIENT_ID=
BBVA_CLIENT_SECRET=

# base64 of the PEM file:  base64 -w0 clave_privada.pem
BBVA_PRIVATE_KEY_BASE64=

# Set to 1 to print the exact stringToSign of every request.
# BBVA answers a bad signature with a bare 401, so this is the only way to compare.
BBVA_DEBUG_SIGNING=
